# Copy to .env, fill in your local PostgreSQL values, and generate a unique key.
DJANGO_SECRET_KEY=replace-with-a-random-local-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_NAME=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_local_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
